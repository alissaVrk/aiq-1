{
  "version": 2,
  "devServer": "auto",
  "devProxy": true,
  "resolveFrom": "frontends/ui",
  "hooksFile": "dazl.hooks.js",
  "fileNamingConvention": "pascal-case",
  "visualEditing": "enabled",
  "ignoredSubPaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/.vscode/**",
    "**/out/**",
    "**/storybook-static/**",
    "**/__pycache__/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/*.db",
    "**/*.db-wal",
    "**/*.db-shm",
    "**/tests/**",
    "**.*/*.spec.*"
  ],
  "projectPrompts": {
    "promptsFolderName": "dazl-prompts"
  },
  "skillPaths": [
    "{.agents,.github,.claude,.cursor}/skills/*.{md,MD}",
    "{.agents,.github,.claude,.cursor}/skills/*/{SKILL,skill}.{md,MD}"
  ]
}
